@model IEnumerable<CoffeeProduct>
@{
    ViewData["Title"] = "Каталог кофе";
}

<div class="row">
    <div class="col-md-3">
        <div class="card">
            <div class="card-header">
                <h5>Категории</h5>
            </div>
            <div class="list-group list-group-flush" id="categories-container">
                <a href="/catalog" class="list-group-item list-group-item-action active">Все товары</a>
                @foreach (var category in ViewBag.Categories ?? new List<string>())
                {
                    <a href="/catalog/category/@category" class="list-group-item list-group-item-action">@category</a>
                }
            </div>
        </div>
    </div>
    
    <div class="col-md-9">
        <h2>Наш каталог кофе</h2>
        
        <div class="row">
            @foreach (var product in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card coffee-card h-100">
                        <img src="@product.ImageUrl" class="card-img-top coffee-image" alt="@product.Name" 
                             onerror="this.src='/images/coffee-placeholder.jpg'">
                        <div class="card-body">
                            <h5 class="card-title">@product.Name</h5>
                            <span class="badge origin-badge">@product.Origin</span>
                            <p class="card-text">@product.Description</p>
                            <p class="card-text">
                                <small class="text-muted">Обжарка: @product.RoastLevel</small>
                            </p>
                        </div>
                        <div class="card-footer">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="price">@product.Price.ToString("C")</span>
                                <button class="btn btn-primary btn-sm" 
                                        onclick="addToCart(@product.Id, '@product.Name')">
                                    <i class="fas fa-cart-plus"></i> В корзину
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Загрузка категорий через API
        $(document).ready(function() {
            loadCategories();
        });
    </script>
}